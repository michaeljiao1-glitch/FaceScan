<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>

  <connectionStrings>
    <!-- SQL Server connection. Initial Catalog is the clinic database; it can also be set with the
         "Database" setting below, or by starting FaceScan.exe /database:cm_otherclinic -->
    <add name="Clinic"
         connectionString="Data Source=192.168.1.10;Initial Catalog=cm_demo;Persist Security Info=false;User ID=YOUR_USER;Password=YOUR_PASSWORD"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Clinic database (Initial Catalog). Leave empty to use the one in the connection string. -->
    <add key="Database" value="" />
    <add key="Schema" value="dbo" />
    <add key="PeopleTable" value="people" />
    <add key="AppointmentsTable" value="appointments" />

    <!-- Folder for enrolled faces (one file per clinic database). Biometric data: keep it protected. -->
    <add key="FaceDataFolder" value="%ProgramData%\FaceScan" />

    <!-- Face match: cosine similarity needed to accept a match (higher = stricter), and how far the best
         patient must be ahead of the next one. A failed match sends the patient to the front desk. -->
    <add key="MatchThreshold" value="0.40" />
    <add key="MatchMargin" value="0.05" />

    <!-- A second scan only counts as leaving if at least this many minutes have passed since arrival. -->
    <add key="MinMinutesBeforeCheckout" value="5" />

    <add key="CameraIndex" value="0" />
  </appSettings>
</configuration>
